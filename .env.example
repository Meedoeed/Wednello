# ─── Основное ───
DOMAIN=wednello.ru                      # домен для Caddy (без https://)
PUBLIC_URL=https://wednello.ru          # внешний адрес: ссылки в письмах, возврат после оплаты
DEMO=0                                  # 1 — демо-кабинет demo@wednello.ru / demo123 (только для показа!)
ADMIN_EMAILS=you@example.com            # кто видит раздел «Статистика» (через запятую)
BACKUPS_KEEP=14                         # сколько ежедневных копий базы хранить в data/backups

# ─── Оплата: ЮKassa (yookassa.ru → Интеграция → Ключи API) ───
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RECEIPT=1                      # 1 — передавать данные для чека 54-ФЗ (если подключены Чеки от ЮKassa)
YOOKASSA_VAT_CODE=1                     # 1 — без НДС (самозанятый/ИП на УСН)
YOOKASSA_TAX_SYSTEM=                    # код СНО, если требуется кассой (2 — УСН доходы)
# В ЛК ЮKassa → Интеграция → HTTP-уведомления укажите:
#   https://<домен>/api/billing/yookassa   события: payment.succeeded, payment.canceled

# ─── Почта (сброс пароля, уведомления об ответах гостей) ───
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=hello@wednello.ru
SMTP_PASS=                              # пароль приложения
MAIL_FROM=hello@wednello.ru
MAIL_FROM_NAME=WEDNELLO

# ─── Аналитика ───
METRIKA_ID=                             # номер счётчика Яндекс Метрики

# ─── Реквизиты для оферты и страницы контактов ───
LEGAL_BRAND=WEDNELLO
LEGAL_NAME=ИП Иванов Иван Иванович
LEGAL_INN=
LEGAL_OGRN=
LEGAL_ADDRESS=
LEGAL_EMAIL=hello@wednello.ru
LEGAL_PHONE=
SUPPORT_TELEGRAM=@wednello_help
