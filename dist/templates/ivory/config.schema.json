{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "locale": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description"
      ]
    },
    "couple": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firstName": {
          "type": "string"
        },
        "secondName": {
          "type": "string"
        },
        "separator": {
          "type": "string"
        }
      },
      "required": [
        "firstName",
        "secondName",
        "separator"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "startAt": {
          "type": "string",
          "format": "date-time"
        },
        "endAt": {
          "type": "string",
          "format": "date-time"
        },
        "timeZone": {
          "type": "string"
        },
        "calendarTitle": {
          "type": "string"
        },
        "calendarDescription": {
          "type": "string"
        },
        "calendarFileName": {
          "type": "string"
        }
      },
      "required": [
        "date",
        "startAt",
        "endAt",
        "timeZone",
        "calendarTitle",
        "calendarDescription",
        "calendarFileName"
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paper": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "gold": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "line": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "dark": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "light": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "paper",
        "ink",
        "muted",
        "gold",
        "line",
        "dark",
        "light"
      ]
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paper": {
          "type": "string"
        },
        "pocket": {
          "type": "string"
        },
        "flap": {
          "type": "string"
        },
        "seal": {
          "type": "string"
        },
        "divider": {
          "type": "string"
        },
        "frame": {
          "type": "string"
        }
      },
      "required": [
        "paper",
        "pocket",
        "flap",
        "seal",
        "divider",
        "frame"
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "enum": [
              "opening",
              "invitation",
              "story",
              "day",
              "place",
              "program",
              "details",
              "rsvp"
            ]
          },
          "uniqueItems": true
        },
        "animation": {
          "type": "boolean"
        }
      },
      "required": [
        "sections",
        "animation"
      ]
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brand": {
          "type": "string"
        },
        "brandAccent": {
          "type": "string"
        },
        "homeLabel": {
          "type": "string"
        },
        "navigationLabel": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "section": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "section",
              "label"
            ]
          }
        }
      },
      "required": [
        "brand",
        "brandAccent",
        "homeLabel",
        "navigationLabel",
        "links"
      ]
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ariaLabel": {
          "type": "string"
        },
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "accent"
          ]
        },
        "description": {
          "type": "string"
        },
        "letterLabel": {
          "type": "string"
        },
        "scrollLabel": {
          "type": "string"
        },
        "sideLabel": {
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "ariaLabel",
        "eyebrow",
        "title",
        "description",
        "letterLabel",
        "scrollLabel",
        "sideLabel"
      ]
    },
    "invitation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "marker": {
          "type": "string"
        },
        "eyebrow": {
          "type": "string"
        },
        "greeting": {
          "type": "string"
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "linkLabel": {
          "type": "string"
        },
        "linkSection": {
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "marker",
        "eyebrow",
        "greeting",
        "paragraphs",
        "linkLabel",
        "linkSection"
      ]
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "accent"
          ]
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signature": {
          "type": "string"
        },
        "photo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            },
            "position": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "x",
                "y"
              ]
            },
            "placeholder": {
              "type": "string"
            },
            "aspectRatio": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?\\s*/\\s*[0-9]+(?:\\.[0-9]+)?$"
            }
          },
          "required": [
            "src",
            "alt",
            "position",
            "placeholder",
            "aspectRatio"
          ]
        }
      },
      "required": [
        "enabled",
        "eyebrow",
        "title",
        "paragraphs",
        "signature",
        "photo"
      ]
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "marker": {
          "type": "string"
        },
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "accent"
          ]
        },
        "calendarLabel": {
          "type": "string"
        },
        "selectedDateLabel": {
          "type": "string"
        },
        "countdownLabel": {
          "type": "string"
        },
        "countdownUnits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled",
        "marker",
        "eyebrow",
        "title",
        "calendarLabel",
        "selectedDateLabel",
        "countdownLabel",
        "countdownUnits",
        "weekdays"
      ]
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "marker": {
          "type": "string"
        },
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "mapUrl": {
          "type": "string"
        },
        "mapLabel": {
          "type": "string"
        },
        "pendingLabel": {
          "type": "string"
        },
        "photo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            },
            "position": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "x",
                "y"
              ]
            },
            "placeholder": {
              "type": "string"
            },
            "aspectRatio": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?\\s*/\\s*[0-9]+(?:\\.[0-9]+)?$"
            }
          },
          "required": [
            "src",
            "alt",
            "position",
            "placeholder",
            "aspectRatio"
          ]
        }
      },
      "required": [
        "enabled",
        "marker",
        "eyebrow",
        "title",
        "address",
        "description",
        "mapUrl",
        "mapLabel",
        "pendingLabel",
        "photo"
      ]
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "marker": {
          "type": "string"
        },
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "accent"
          ]
        },
        "note": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "time": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "icon": {
                "oneOf": [
                  {
                    "type": "string",
                    "description": "Built-in key from icons.mjs; unknown key renders no icon."
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "src"
                    ],
                    "properties": {
                      "src": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "id",
              "time",
              "title",
              "description",
              "icon"
            ]
          }
        }
      },
      "required": [
        "enabled",
        "marker",
        "eyebrow",
        "title",
        "note",
        "items"
      ]
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "accent"
          ]
        },
        "description": {
          "type": "string"
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "color": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "color",
              "label"
            ]
          }
        }
      },
      "required": [
        "enabled",
        "eyebrow",
        "title",
        "description",
        "colors"
      ]
    },
    "rsvp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "marker": {
          "type": "string"
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "accent"
          ]
        },
        "description": {
          "type": "string"
        },
        "formTitle": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "label",
              "required"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "type": {
                "enum": [
                  "text",
                  "email",
                  "tel",
                  "number",
                  "textarea",
                  "radio",
                  "select"
                ]
              },
              "label": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "placeholder": {
                "type": "string"
              },
              "autocomplete": {
                "type": "string"
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value",
                    "label"
                  ],
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "enum": [
                        "radio",
                        "select"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "options"
                  ]
                }
              }
            ]
          }
        },
        "submission": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "local",
                "endpoint"
              ]
            },
            "endpoint": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "endpoint"
          ]
        },
        "submitLabel": {
          "type": "string"
        },
        "submittingLabel": {
          "type": "string"
        },
        "downloadLabel": {
          "type": "string"
        },
        "downloadFileName": {
          "type": "string"
        },
        "privacyNote": {
          "type": "string"
        },
        "messages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "localSuccess": {
              "type": "string"
            },
            "storageError": {
              "type": "string"
            },
            "success": {
              "type": "string"
            },
            "error": {
              "type": "string"
            },
            "required": {
              "type": "string"
            }
          },
          "required": [
            "localSuccess",
            "storageError",
            "success",
            "error",
            "required"
          ]
        }
      },
      "required": [
        "enabled",
        "marker",
        "title",
        "description",
        "formTitle",
        "fields",
        "submission",
        "submitLabel",
        "submittingLabel",
        "downloadLabel",
        "downloadFileName",
        "privacyNote",
        "messages"
      ]
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "backLabel": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "eyebrow",
        "backLabel",
        "note"
      ]
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loadError": {
          "type": "string"
        },
        "photoError": {
          "type": "string"
        }
      },
      "required": [
        "loadError",
        "photoError"
      ]
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "src",
        "volume",
        "loop",
        "labels"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "src": {
          "type": "string",
          "description": "Relative audio file or HTTP(S) URL. Empty string hides the player."
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "loop": {
          "type": "boolean"
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "play",
            "pause",
            "loading",
            "error"
          ],
          "properties": {
            "play": {
              "type": "string"
            },
            "pause": {
              "type": "string"
            },
            "loading": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "locale",
    "meta",
    "couple",
    "event",
    "theme",
    "assets",
    "layout",
    "header",
    "opening",
    "invitation",
    "story",
    "day",
    "place",
    "program",
    "details",
    "rsvp",
    "footer",
    "ui"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivory-letter.example/config.schema.json",
  "title": "Ivory Letter invitation config v1"
}
